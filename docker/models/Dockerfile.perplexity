# syntax=docker/dockerfile:1
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
WORKDIR /app
ARG TARGETARCH
RUN test "$TARGETARCH" = "amd64"
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ git libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md LICENSE NOTICE THIRD_PARTY_NOTICES.md ./
COPY decision_workbench ./decision_workbench
COPY requirements/perplexity-native.txt ./requirements/
RUN python -m pip install --no-cache-dir -r requirements/perplexity-native.txt '.[gcp,azure,runpod]' \
    && python -m pip check
# Publisher logging requires Git metadata. Track only public source, never weights or credentials.
RUN git config --system --add safe.directory /app \
    && git init && git add decision_workbench pyproject.toml README.md LICENSE NOTICE THIRD_PARTY_NOTICES.md requirements \
    && GIT_AUTHOR_DATE=2026-10-18T00:00:00Z GIT_COMMITTER_DATE=2026-10-18T00:00:00Z \
    git -c user.name='Decision Model Workbench' -c user.email='build@example.invalid' commit -m 'Build native training source'
ENV DMT_CLOUD_IMAGE_BACKEND=perplexity-native \
    DMT_PERPLEXITY_CACHE=/tmp/perplexity-runtime \
    DMT_PERPLEXITY_CHECKPOINT=/app/model-cache/perplexity/models--perplexity-ai--pplx-decider-v1.1-27b/snapshots/14c9d90137962d300f3de95633f7b6535e80c5ce \
    HF_MODULES_CACHE=/tmp/perplexity-modules \
    TRITON_CACHE_DIR=/tmp/perplexity-triton \
    CUDA_CACHE_PATH=/tmp/perplexity-cuda \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Explicit image construction downloads the complete 52.2 GB checkpoint.
# Optional gated-model credentials are BuildKit secrets, never image ARGs or ENV values.
RUN --mount=type=secret,id=hf_token,required=false \
    if [ -f /run/secrets/hf_token ]; then export HF_TOKEN="$(cat /run/secrets/hf_token)"; fi; \
    python -m decision_workbench.training.native_image --backend perplexity-native \
    --cache /app/model-cache/perplexity --metadata /app/perplexity-image.json \
    && test -d "$DMT_PERPLEXITY_CHECKPOINT"
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 OMP_NUM_THREADS=32 MKL_NUM_THREADS=32
CMD ["python", "-m", "decision_workbench.training.cloud_runner", "--help"]
