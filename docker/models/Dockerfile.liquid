FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
WORKDIR /app
ARG TARGETARCH
ARG LIQUID_PROFILE=liquid-omni
RUN test "$TARGETARCH" = "amd64" && \
    case "$LIQUID_PROFILE" in liquid-trl|liquid-unsloth|liquid-omni) ;; *) exit 1 ;; esac
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ git libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements/torch-linux-amd64-py312-cu126.txt ./requirements/torch-linux-amd64-py312-cu126.txt
RUN python -m pip install --no-cache-dir --no-deps --require-hashes --only-binary=:all: \
    --index-url https://download.pytorch.org/whl/cu126 -r requirements/torch-linux-amd64-py312-cu126.txt \
    && python -m pip install --no-cache-dir --no-deps --only-binary=:all: \
    --index-url https://download.pytorch.org/whl/cu126 torchvision==0.25.0+cu126
COPY pyproject.toml README.md LICENSE NOTICE THIRD_PARTY_NOTICES.md ./
COPY decision_workbench ./decision_workbench
COPY requirements/liquid-trl.txt requirements/liquid-unsloth.txt requirements/liquid-omni.txt ./requirements/
RUN python -m pip install --no-cache-dir -r "requirements/${LIQUID_PROFILE}.txt" '.[gcp,azure,runpod]' \
    && python -m pip check
ENV DMT_CLOUD_IMAGE_BACKEND=${LIQUID_PROFILE} \
    DMT_LIQUID_CACHE=/app/model-cache/liquid-hub \
    DMT_OMNI_CACHE=/app/model-cache/liquid-omni-hub \
    HF_MODULES_CACHE=/tmp/liquid-modules \
    TRITON_CACHE_DIR=/tmp/liquid-triton \
    CUDA_CACHE_PATH=/tmp/liquid-cuda \
    UNSLOTH_COMPILE_LOCATION=/tmp/liquid-unsloth-compiled \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
RUN if [ "$LIQUID_PROFILE" = liquid-omni ]; then cache="$DMT_OMNI_CACHE"; else cache="$DMT_LIQUID_CACHE"; fi; \
    python -m decision_workbench.training.liquid_image --backend "$LIQUID_PROFILE" \
    --cache "$cache" --metadata /app/liquid-image.json
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
CMD ["python", "-m", "decision_workbench.training.cloud_runner", "--help"]
