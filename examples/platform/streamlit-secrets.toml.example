# Copy to the UI server's private .streamlit/secrets.toml and configure real values.
[auth]
redirect_uri = "https://workbench.example.com/oauth2callback"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
expose_tokens = ["access"]

[auth.enterprise]
client_id = "YOUR_OIDC_WEB_CLIENT_ID"
client_secret = "YOUR_OIDC_WEB_CLIENT_SECRET"
server_metadata_url = "https://identity.example.com/realms/enterprise/.well-known/openid-configuration"
client_kwargs = {scope = "openid profile decisions.read", code_challenge_method = "S256", prompt = "login"}
