# Python commands read process variables; they do not automatically load this file.
# Docker Compose can load it for its explicitly referenced environment fields.
DMT_HOME=data/workspace
DMT_KEYS_FILE=data/operator-keys.json
# Optional trusted JWT issuer/audience/JWKS and subject/group mapping file.
DMT_SSO_FILE=
# Optional private backup monitor profile; API uses public verification keys only.
DMT_BACKUP_MONITOR_PROFILE=
DMT_API_URL=http://127.0.0.1:8080
# Optional UI-only OIDC sign-in. Configure private Streamlit secrets and API JWT
# trust first; the default workspace mode preserves personal localhost startup.
DMT_UI_AUTH_MODE=workspace
DMT_UI_OIDC_PROVIDER=enterprise
# Optional separately configured GPU worker Python executable.
DMT_WORKER_PYTHON=
# Optional absolute shared model-capacity lock path; use the same file in all
# local API/worker processes sharing a GPU. Blank uses the user's cache directory.
DMT_MODEL_RESOURCE_LOCK=
# GPU Compose overlay: create this external shared volume before startup.
DMT_MODEL_RESOURCE_VOLUME=decision-workbench-model-resources
# Separate Liquid d1-3B interpreter for training and resident serving.
# Use an absolute executable path from requirements/liquid-trl.txt.
DMT_LIQUID_PYTHON=
# Separate CUDA FastVisionModel environment; requirements/liquid-unsloth.txt.
DMT_LIQUID_UNSLOTH_PYTHON=
# Optional private checkpoint cache; defaults beside the workspace.
DMT_LIQUID_CACHE=
# Optional operator-scoped, pinned local CPU encoder for semantic candidate audits.
DMT_SEMANTIC_PROFILE_FILE=
# Worker-only Python with the exact model libraries declared by that profile.
DMT_SEMANTIC_PYTHON=
# Operator-approved generative chat teacher; never put credentials in a URL.
DMT_TEACHER_BASE_URL=
DMT_TEACHER_MODEL=
# Leave blank for json_object; choose json_schema for a compatible teacher.
# Set the same nonsecret value in the API and worker before startup.
DMT_TEACHER_RESPONSE_FORMAT=
DMT_TEACHER_API_KEY=
# Optional schema drafts use the same teacher, with bounded one-shot requests.
DMT_SCHEMA_TIMEOUT_SECONDS=60
DMT_SCHEMA_CALLS_PER_DAY=20
# Optional schema-teacher compatibility overrides; blank preserves saved defaults.
DMT_SCHEMA_TOKEN_PARAMETER=
DMT_SCHEMA_OUTPUT_TOKENS=
DMT_SCHEMA_TEMPERATURE=
# Synthetic candidate requests: identical nonsecret settings in API and worker.
DMT_GENERATION_TIMEOUT_SECONDS=120
DMT_GENERATION_CALLS_PER_DAY=20
DMT_GENERATION_MAX_INFLIGHT=1
DMT_GENERATION_OUTPUT_TOKENS=6000
DMT_GENERATION_MAX_ATTEMPTS=3
# Select the parameter supported by your teacher; temperature can be "omit".
DMT_GENERATION_TOKEN_PARAMETER=max_tokens
DMT_GENERATION_TEMPERATURE=0.7
# Both token rates or neither. Empty means unknown, not free.
DMT_GENERATION_INPUT_USD_PER_MILLION=
DMT_GENERATION_OUTPUT_USD_PER_MILLION=
# Optional token-cost estimate admission limits, not account spending ceilings.
DMT_GENERATION_MAX_ESTIMATED_REQUEST_USD=
DMT_GENERATION_MAX_ESTIMATED_DAY_USD=
# Legacy maintenance generation CLI uses this separate name.
TEACHER_API_KEY=

# Optional hosted decision profiles, configured in both API and worker processes.
# In Compose use /run/config/decision-profiles.json after creating data/config/decision-profiles.json.
DMT_DECISION_PROFILES_FILE=
DMT_PROVIDER_TYPESAFE_API_KEY=
DMT_PROVIDER_OPENROUTER_API_KEY=
DMT_PROVIDER_PERPLEXITY_API_KEY=
DMT_PROVIDER_CLOUDFLARE_API_KEY=
DMT_PROVIDER_LIQUID_API_KEY=

# Optional local omni interpreter; never a path selected by an API request.
# Install requirements/liquid-omni.txt in a separate Python 3.12 environment.
DMT_OMNI_PYTHON=
DMT_OMNI_CACHE=

# Optional separate D3 family model interpreter and pinned checkpoint cache
DMT_D3_PYTHON=
DMT_D3_CACHE=

# Optional native Perplexity v1.1 profile: Linux CUDA worker with large VRAM/RAM.
# Paths are operator-owned; the app never downloads this checkpoint.
DMT_PERPLEXITY_PYTHON=
DMT_PERPLEXITY_CHECKPOINT=
DMT_PERPLEXITY_CACHE=
DMT_PERPLEXITY_TRAINING_TIMEOUT_SECONDS=86400

# Optional reviewed taxonomy discovery; server/worker only.
# In Compose use /run/config/taxonomy-profiles.json with a private scoped profile.
DMT_TAXONOMY_PROFILES_FILE=
DMT_TAXONOMY_TYPESAFE_API_KEY=

# Managed AWS/GCP training (server/worker only; operator-owned file and temporary credentials).
# No resources are allocated until an owner approves and submits a frozen run.
DMT_CLOUD_PROFILES_FILE=
DMT_CLOUD_AWS_ACCESS_KEY_ID=
DMT_CLOUD_AWS_SECRET_ACCESS_KEY=
DMT_CLOUD_AWS_SESSION_TOKEN=

# GCP operator service-account JSON; private server/worker config only.
# In Compose use /run/config/gcp-operator.json after provisioning it privately.
DMT_CLOUD_GCP_CREDENTIALS_FILE=

# Azure operator application/tenant IDs belong to its private approved profile.
DMT_CLOUD_AZURE_CLIENT_SECRET=

# Selected managed RunPod credentials; never passed to the web process or GPU Pod
DMT_CLOUD_RUNPOD_API_KEY=
DMT_CLOUD_RUNPOD_S3_ACCESS_KEY_ID=
DMT_CLOUD_RUNPOD_S3_SECRET_ACCESS_KEY=

# Optional Modal selected operator tokens: API/worker only, never web.
DMT_CLOUD_MODAL_TOKEN_ID=
DMT_CLOUD_MODAL_TOKEN_SECRET=
